# .env.example

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY='your_secret_key'

# Database Configuration
DATABASE_URL='sqlite:///your_database.db' # Example for SQLite
# DATABASE_URL='mysql://user:password@localhost/dbname' # Example for MySQL
# DATABASE_URL='postgresql://user:password@localhost/dbname' # Example for PostgreSQL
